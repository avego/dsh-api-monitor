{
  "name": "dsh-api-monitor",
  "version": "1.0.0",
  "type": "module",
  "description": "Inspects the DSH Host's outbound API calls in a right-sidebar tab: URL, method, every request header, JSON body and response, with streamed replies assembled into readable text.",
  "license": "MIT",
  "author": "Alexander Tishov (https://avego.org)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avego/dsh-api-monitor.git"
  },
  "homepage": "https://github.com/avego/dsh-api-monitor#readme",
  "bugs": {
    "url": "https://github.com/avego/dsh-api-monitor/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "api",
    "monitor",
    "inspector",
    "http",
    "headers",
    "debugging"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "icon.png",
    "screenshots.json",
    "LICENSE",
    "README.md",
    "README.ru.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
