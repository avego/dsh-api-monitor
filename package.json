{
  "name": "@local/dsh-api-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Right-Sidebar API monitor: every outbound API request with its full headers and JSON body.",
  "license": "MIT",
  "author": "Alexander Tishov (https://avego.org)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avego/dsh-api-monitor.git"
  },
  "homepage": "https://github.com/avego/dsh-api-monitor#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.ru.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
